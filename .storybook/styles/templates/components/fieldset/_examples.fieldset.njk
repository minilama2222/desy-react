{% from "components/input/_macro.input.njk" import componentInput %}

{% macro callerExample(id='id') %}
{{ componentInput({
  "label": {
    "text": "Número de teléfono"
  },
  "id": "tel-id-" + id,
  "name": "tel-name-" + id
})  }}
{% endmacro %}

{% macro callerErrorExample(id='id') %}
{{ componentInput({
  "label": {
    "text": "Número de teléfono"
  },
  "id": "tel-error-id-" + id,
  "name": "tel-error-name-" + id,
  "errorMessage": {
    "text": "Mensaje de error aqui"
  }
})  }}
{% endmacro %}


