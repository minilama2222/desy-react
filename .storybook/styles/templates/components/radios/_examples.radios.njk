{% from "components/fieldset/_macro.fieldset.njk" import componentFieldset %}
{% from "components/input/_macro.input.njk" import componentInput %}
{% from "components/radios/_macro.radios.njk" import componentRadios %}

{% macro telefonoContent(id='id') %}
  {% call componentFieldset({
    "legend": {
      "text": "¿Cuál es tu número de teléfono fijo?",
      "classes": "mb-sm sr-only"
    }
  }) %}
    <div class="c-form-group">
    {{ componentInput({
        "label": {
          "text": "Número de teléfono fijo"
        },
        "id": "telefono-" + id,
        "name": "telefono-name-" + id
      })  }}
    </div>
  {% endcall  %}
{% endmacro %}

{% macro mobileContent(id='id') %}
  {% call componentFieldset({
    "legend": {
      "text": "¿Cuál es tu número de teléfono móvil?",
      "classes": "mb-sm sr-only"
    }
    }) %}
    <div class="c-form-group">
    {{ componentInput({
        "label": {
          "text": "Número de teléfono móvil"
        },
        "id": "mobile-" + id,
        "name": "mobile-name-" + id
      })  }}
    </div>
  {% endcall  %}
{% endmacro %}

{% macro mobileErrorContent(id='id') %}
  {% call componentFieldset({
    "legend": {
      "text": "¿Cuál es tu número de teléfono móvil?",
      "classes": "mb-sm sr-only"
    }
    }) %}
    <div class="c-form-group">
      {{ componentInput({
        "label": {
          "text": "Número de teléfono móvil"
        },
        "id": "input-with-error-message-" + id,
        "name": "test-name-" + id,
        "errorMessage": {
          "text": "Este campo no puede estar vacío"
        }
        })  }}
    </div>
  {% endcall  %}
{% endmacro %}

{% macro grandchildContent(id='id') %}
  {{ componentRadios({
    "idPrefix": "grandchild-" + id,
    "name": "grandchild-" + id,
    "items": [
      {
        "name": "oficina-principal-" + id,
        "id": "oficina-principal-id-" + id,
        "value": "oficina-principal-" + id,
        "checked": true,
        "html": "Oficina principal"
      },
      {
        "name": "oficina-secundaria-" + id,
        "id": "oficina-secundaria-id-" + id,
        "value": "oficina-secundaria-" + id,
        "html": "Oficina secundaria"
      }
    ]
  }) }}
{% endmacro %}

{% macro nestedContent(id='id') %}
  {{ componentRadios({
    "idPrefix": "with-conditional-items-checked-nested-" + id,
    "name": "with-conditional-items-checked-nested-" + id,
    "items": [
      {
        "value": "oficinas-de-registro",
        "text": "Oficinas de registro",
        "checked": true,
        "conditional": {
          "html": grandchildContent('oficinas-de-registro-' + id).val
        }
      },
      {
        "value": "oficinas-locales",
        "text": "Oficinas locales",
        "conditional": {
          "html": grandchildContent('oficinas-locales-' + id).val
        }
      }
    ]
  }) }}
{% endmacro %}

