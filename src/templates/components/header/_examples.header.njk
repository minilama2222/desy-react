{% from "components/nav/_macro.nav.njk" import componentNav %}
{% from "components/details/_macro.details.njk" import componentDetails %}
{% from "components/menu-navigation/_macro.menu-navigation.njk" import componentMenuNavigation %}

{% set navigationCustom %}

  {{ componentMenuNavigation({
    "idPrefix": "header-custom-nav",
    "classes": "c-menu-navigation--last-right hidden lg:block w-full bg-neutral-lighter ",
    "items": [
      {
        "text": "Custom Item 1",
        "id": "header-custom-nav-item-1",
        "classes": "c-menu-navigation__button--header -mr-base",
        "sub": {
          "items": [
            {
              "href": "#",
              "text": "Subitem 1"
            },
            {
              "href": "#",
              "text": "Subitem 2"
            },
            {
              "href": "#",
              "text": "Subitem 3"
            }
          ],
          "attributes": {
            "aria-labelledby": "header-custom-nav-item-1"
          }
        }
      },
      {
        "text": "Custom Active Item 2",
        "id": "header-custom-nav-item-2",
        "classes": "c-menu-navigation__button--header -mr-base",
        "active": true,
        "sub": {
          "items": [
            {
              "href": "#",
              "text": "Subitem 1"
            },
            {
              "href": "#",
              "text": "Subitem 2",
              "active": true
            },
            {
              "href": "#",
              "text": "Subitem 3"
            }
          ],
          "attributes": {
            "aria-labelledby": "header-custom-nav-item-2"
          }
        }
      },
      {
        "text": "Custom Item 3",
        "id": "header-custom-nav-item-3",
        "classes": "c-menu-navigation__button--header -mr-base",
        "sub": {
          "items": [
            {
              "href": "#",
              "text": "Subitem 1"
            },
            {
              "href": "#",
              "text": "Subitem 2"
            },
            {
              "href": "#",
              "text": "Subitem 3"
            }
          ],
          "attributes": {
            "aria-labelledby": "header-custom-nav-item-3"
          }
        }
      },
      {
          "text": "Item 4 right",
          "id": "header-custom-nav-item-4",
          "classes": "c-menu-navigation__button--header",
          "sub": {
            "items": [
              {
                "href": "#",
                "text": "Subitem 1"
              },
              {
                "href": "#",
                "text": "Subitem 2"
              },
              {
                "href": "#",
                "text": "Subitem 3"
              }
            ],
            "attributes": {
              "aria-labelledby": "header-custom-nav-item-4"
            }
          }
        }
    ],
    "attributes": {
      "aria-label": "Menú principal"
    }
  }) | indent(12)  }}
{% endset %}

{% set exampleOffcanvas %}

  <nav class="w-full p-2" aria-label="Menú móvil">
    <h3 class="p-base text-base font-bold">Gestor de expedientes</h3>
    {{ componentNav({
      "idPrefix": "nav-mobile-pages",
      "hasNav": false,
      "items": [
        {
          "href": "#",
          "text": "Inicio",
          "active": true
        },
        {
          "href": "#",
          "text": "Expedientes"
        },
        {
          "href": "#",
          "text": "Bandejas",
          "divider": true
        }
      ],
      "attributes": {
        "aria-label": "Lista de páginas"
      }
    })  }}
    <h3 class="p-base text-base font-bold">Usuario/a: Marta Pérez</h3>
    {{ componentNav({
      "idPrefix": "nav-mobile-user",
      "hasNav": false,
      "items": [
        {
          "href": "#",
          "text": "Perfil"
        },
        {
          "href": "#",
          "text": "Cerrar sesión",
          "divider": true
        }
      ],
      "attributes": {
        "aria-label": "Lista de acciones de usuario"
      }
    })  }}
    {% call componentDetails({
      "classes": "px-base",
      "summary": {
        "html": "Cambiar de aplicación",
        "classes": "c-link text-sm"
      }
    })  %}
        {{ componentNav({
          "idPrefix": "nav-mobile-apps",
          "hasNav": false,
          "items": [
            {
              "href": "#",
              "text": "Gestor de expedientes",
              "active": true
            },
            {
              "href": "#",
              "text": "Catálogo de servicios"
            },
            {
              "href": "#",
              "text": "Bandeja de entrada"
            },
            {
              "href": "#",
              "text": "Sistema de comprobación y verificación de documentos por CSV"
            }
          ],
          "attributes": {
            "aria-label": "Lista de aplicaciones"
          }
        })  }}
    {% endcall %}
  </nav>
{% endset %}

