{% from "../error-message/_macro.error-message.njk" import componentErrorMessage -%}
{% from "../fieldset/_macro.fieldset.njk" import componentFieldset %}
{% from "../hint/_macro.hint.njk" import componentHint %}
{% from "../input/_macro.input.njk" import componentInput %}
{% from "../select/_macro.select.njk" import componentSelect %}

{#- a record of other elements that we need to associate with the input using
   aria-describedby – for example hints or error messages -#}
{% set describedBy = params.fieldset.describedBy if params.fieldset.describedBy else "" %}

{#- Capture the HTML so we can optionally nest it in a fieldset -#}
{% set innerHtml %}
{% if params.hint %}
  {% set hintId = params.id + "-hint" %}
  {% set describedBy = describedBy + " " + hintId if describedBy else hintId %}
{{ componentHint({
  id: hintId,
  classes: params.hint.classes,
  attributes: params.hint.attributes,
  html: params.hint.html,
  text: params.hint.text
}) }}
{% endif %}
{% if params.errorMessage %}
  {% set errorId = params.id + "-error" %}
{{ componentErrorMessage({
  id: errorId,
  classes: params.errorMessage.classes,
  attributes: params.errorMessage.attributes,
  html: params.errorMessage.html,
  text: params.errorMessage.text,
  visuallyHiddenText: params.errorMessage.visuallyHiddenText
}) }}
{% endif %}
<div class="{% if params.classes %}{{ params.classes }}{% else %}flex{% endif %}"
  {%- for attribute, value in params.attributes %} {{attribute}}="{{value}}"{% endfor %}
  {%- if params.id %} id="{{ params.id }}"{% endif %}>
  {% for item in params.items %}
    {% if item.isSelect %}
      {% if item.selectItems %}
  {{ componentSelect({
    label: item.label,
    id: item.id if item.id else (params.id + "-" + item.name),
    formGroup: item.formGroup,
    classes: "mb-0 " + (item.classes if item.classes),
    name: (params.namePrefix + "-" + item.name) if params.namePrefix else item.name,
    disabled: item.disabled,
    attributes: item.attributes,
    items: item.selectItems
  }) | indent(2) }}
      {% endif %}
    {% elseif item.divider %}
  <div {%- if item.divider.classes %} class="{{ item.divider.classes }}{% endif %}" role="presentation" aria-hidden="true">
    {% if item.divider.html %}
      {{ item.divider.html | filterquotes | safe }}
    {% else %}
      <p>
        {{ item.divider.text }}
      </p>
    {% endif %}
  </div>
    {% else %}
  {{ componentInput({
    label: item.label,
    id: item.id if item.id else (params.id + "-" + item.name),
    formGroup: item.formGroup,
    classes: "mb-0 " + (item.classes if item.classes),
    name: (params.namePrefix + "-" + item.name) if params.namePrefix else item.name,
    value: item.value,
    type: item.type if item.type else "text",
    inputmode: item.inputmode,
    autocomplete: item.autocomplete,
    pattern: item.pattern,
    placeholder: item.placeholder,
    disabled: item.disabled,
    attributes: item.attributes
  }) | indent(2) }}
    {% endif %}
{% endfor %}
</div>
{% endset %}

{% set formGroupContent %}
  {% if params.fieldset %}
  {#- We override the fieldset's role to 'group' because otherwise JAWS does not
    announce the description for a fieldset comprised of text inputs, but
    adding the role to the fieldset always makes the output overly verbose for
    radio buttons or checkboxes. -#}
  {% call componentFieldset({
    describedBy: describedBy,
    classes: params.fieldset.classes,
    role: 'group',
    attributes: params.fieldset.attributes,
    legend: params.fieldset.legend,
    headingLevel: params.fieldset.headingLevel
  }) %}
{{ innerHtml | safe }}
    {% endcall %}
  {% else %}
{{ innerHtml | safe }}
  {% endif %}
{% endset %}

<!-- input-group -->
<div class="c-form-group {%- if params.errorMessage %} c-form-group--error{% endif %} {%- if params.formGroup.classes %} {{ params.formGroup.classes }}{% endif %}">
  {{ formGroupContent | safe | indent(2) }}
</div>
<!-- /input-group -->